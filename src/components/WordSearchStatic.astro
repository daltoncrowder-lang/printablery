---
import { buildPuzzle, mulberry32, seedFromString } from '../lib/wordsearch.js';
const { title = 'Word Search', words = [], size = 13 } = Astro.props;
// Deterministic build-time puzzle so the page has real content without JS.
const rng = mulberry32(seedFromString(title + size));
const { grid } = buildPuzzle(words, { size, difficulty: 'medium', rng });
---
<div class="ws-puzzle" style={`grid-template-columns:repeat(${size},1fr)`} role="img" aria-label={`${title} word search puzzle`}>
  {grid.map((row) => row.map((ch) => <div class="ws-cell">{ch}</div>))}
</div>
